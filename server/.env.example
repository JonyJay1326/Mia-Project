# DeepSeek（OpenAI 兼容）—— 把本文件复制为 .env 并填入密钥
# cp .env.example .env

MIA_AI_API_KEY=sk-你的deepseek密钥
MIA_AI_BASE_URL=https://api.deepseek.com/v1
MIA_AI_MODEL=deepseek-chat

# 应用内登录（留空 MIA_AUTH_PASSWORD 则开发环境不强制鉴权）
MIA_AUTH_USERNAME=mia
MIA_AUTH_PASSWORD=请改成强密码
MIA_AUTH_SECRET=请改成随机长字符串
MIA_AUTH_TOKEN_DAYS=30

# 监听地址（生产默认 127.0.0.1；端口与 Nginx 反代一致）
# MIA_HOST=127.0.0.1
# MIA_PORT=3001

# 档案路径（默认自动找项目根目录 Mia档案.md）
# MIA_ARCHIVE_PATH=D:\Code\ccode\Mia-Project\Mia档案.md
